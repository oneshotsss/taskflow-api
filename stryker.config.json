{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing. Run with `make mutation` (or `npm run test:mutation`). Uses the fast unit/API suite (in-memory repositories + mocked pool), so no database is needed.",
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/services/**/*.js",
    "src/repositories/idempotency.js",
    "src/db/query.js",
    "src/db/pool.js",
    "src/middleware/errorHandler.js"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 90, "low": 80, "break": 90 },
  "concurrency": 4,
  "timeoutMS": 10000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
